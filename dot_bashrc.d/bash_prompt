# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm* | rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*) ;;
esac

if [ "$color_prompt" = yes ]; then
    # Set bash prompt variable
    PS0='\[\e]133;C\e\\\]'
    # 'start prompt' indicator
    PS1='\[\e]133;A\e\\\]'
    # chroot, if set
    PS1+='${debian_chroot:+($debian_chroot)}'
    # colorized "user@host:"
    PS1+='\[\033[01;32m\]\u@\h\[\033[00m\]:'
    # colorized current directory
    PS1+='\[\033[01;34m\]\w\[\033[00m\]'
    # right-justified timestamp
    PS1+='\[\033[s\033[${COLUMNS}C\033[19D\]\D{%Y-%m-%d %T}\[\033[u\]'
    # prompt indicator on a newline
    PS1+='\n\$ '
    # 'stop prompt' indicator
    PS1+='\[\e]133;B\e\\\]'

    # One-line version (TODO add timestamp):
    #PS1='\[\e]133;A\e\\\]${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\n\$ \[\e]133;B\e\\\]'
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

###
# Prompt Variables
#
# Prompt variables has special escaping:
# \[ and \] indicate that the enclosed characters produce no visible output
#
# TODO finish a high-level overview of escaping (CSI vs OSC vs ?)

###
# PS0: bash prompt variable
# This value is displayed:
# - after a command is read
# - before that command is executed
#
# PS1: primary prompt
# Displayed before command entry
#
# PS2: continuation prompt
# Displays on a multi-lineinput
#
# PS3: prompt used by `select` builtin (? TODO)
#
# PS4: prefix shown for each command in `xtrace` output (? TODO)

###
# Control Sequence Indicators (CSI)
###
# ESC [ <parameter bytes> <intermediate bytes> <final byte>
# Prefix is one of:
# ESC[
# \e[
# \033[
# \x1b[
#
# I often use 033 (CSI) to contrast it with 133 (OSC) and other
#
# Parameter byte(s):
# 0, 1, etc
#
# Intermediate bytes:
# ?
#
# Final byte indicates terminal behavior such as cursor motion, color attribute, etc, such as:
# - cursor up: A
# - cursor down: B
# - cursor right: C
# - cursor left: D
# - Select Graphic Rendition (color attributes): m

###
# Operating System Commands (OSC)
###
# ESC ] <Ps> ; <Pt> ST
# where:
# - Ps is a numeric command identifier
# - ; is a delimiter
# - Pt is a parameter payload
# - ST is a string terminator, ESC \
#   - May also be BEL
#   - Often written as ESC \\

###
# OSC 133: shell integration
# This defines semantic prompt markers:
# - A is prompt start (the beginning of the shell prompt)
# - B is prompt end / command input start (where what you type begins)
# - C is command output start (you pressed Enter; output begins here)
# - D is command finished (optionally carries the exit status, e.g. 133;D;0)
#
# Example:
# ESC ] 133 ; A ESC \
# or in more compact form:
# \e]133;A\e\

###
# CSI 033: Select Graphic Rendition (SGR)
# That is, text rendering attributes
#
## Colors:
# Set with the CSI final byte `m`
#
# Attributes:
# 0: reset
# 1: bold
# 2: dim
# 3: italic (if supported)
# 4: underline
# 5: slow blink
# 6: rapid blink
# etc
#
# Colors:
# _0: black
# _1: red
# _2: green
# _3: yellow
# _4: blue
# _5: magenta
# _6: cyan
# _7: white
# _9: default foreground/background (reset, not bright)
#
# Where:
# 30-39 are foreground
# 40-49 are background
# 90-97 are bright foreground
# 100-109 are bright background
#
# "Bright black" is grey
#
