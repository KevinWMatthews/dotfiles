#!/usr/bin/env bash

set -euo pipefail

{{ template "bash-helpers.sh" . }}

echo_command "Checking for tmux..."

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux not found"
    echo "To configure tmux, first install it and then re-run 'chezmoi apply'"
    exit 0
fi

echo "Found tmux; configuring"

if ! command -v tpack >/dev/null 2>&1; then
    echo "tpack not found; run 'chezmoi apply' again after it installs" >&2
    exit 0
fi

echo "Installing tmux plugins via tpack..."
tpack install
