#!/usr/bin/env bash

set -euo pipefail

{{ template "bash-helpers.sh" . }}

echo_command "Installing tpack..."

{{- if eq .chezmoi.arch "amd64" }}
ARCH="amd64"
{{- else }}
{{ fail (printf "unsupported arch: %s" .chezmoi.arch) }}
{{- end }}

{{- if not .tpack.version }}
{{ fail "tpack.version is not set" }}
{{- else }}
VERSION_TAG="{{ .tpack.version }}"
{{- end }}

# strip 'v' prefix from version tag
VERSION="${VERSION_TAG#v}"
INSTALL_ROOT="$HOME/.local/opt/tpack-$VERSION_TAG"
BIN_LINK="$HOME/.local/bin/tpack"

# Exit success if already installed
# To reinstall, delete the binary and clear chezmoi's scriptState, then apply
if [ -x "$BIN_LINK" ] && [ "$(readlink -f "$BIN_LINK")" = "$INSTALL_ROOT/tpack" ]; then
    echo "tpack already installed"
    exit 0
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
TARBALL="$TMP/tpack-$VERSION_TAG.tar.gz"

URL="https://github.com/tmuxpack/tpack/releases/download/${VERSION_TAG}/tpack_${VERSION}_linux_${ARCH}.tar.gz"
echo "Downloading $URL to $TARBALL..."
curl --fail --silent --show-error \
    --location "$URL" \
    --output "$TARBALL"

DEST="$INSTALL_ROOT"
echo "Extracting $TARBALL to $DEST..."
rm -rf "$INSTALL_ROOT"
mkdir -p "$DEST"
tar --extract \
    --file "$TARBALL" \
    --directory "$DEST"

mkdir -p "$HOME/.local/bin"
ln --symbolic --force "$INSTALL_ROOT/tpack" "$BIN_LINK"

echo "Installed tpack"
